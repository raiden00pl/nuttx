# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_CHIP_STM32N6

comment "STM32N6 Configuration Options"

config STM32_N6_PERIPHERALS
	bool
	default y
	select STM32_HAVE_IP_ADC_V3_N6
	select STM32_HAVE_IP_DMA_GPDMA
	select STM32_HAVE_IP_EXTI_M33M55_V1
	select STM32_HAVE_IP_GPIO_M33M55_V1
	select STM32_HAVE_IP_I2C_M33M55_V2
	select STM32_HAVE_IP_TIMERS_V3
	select STM32_HAVE_COMMON_PWM
	select STM32_HAVE_TIM_PWM_H7
	select STM32_HAVE_IP_DBGMCU_V8
	select STM32_HAVE_IP_LPTIM_V2
	select STM32_HAVE_IP_LTDC_V2
	select STM32_HAVE_IP_OTG_V2
	select STM32_HAVE_OTGHS_HOST
	select STM32_HAVE_IP_RNG_M3M4_V1
	select STM32_HAVE_IP_RTCC_V3
	select STM32_HAVE_IP_SAI_V2
	select STM32_HAVE_IP_SDMMC_IDMA
	select STM32_HAVE_IP_SPI_V5
	select STM32_HAVE_IP_WDG_V3
	select STM32_HAVE_IP_XSPI_V1
	select STM32_HAVE_ADC2
	select STM32_HAVE_DCMIPP
	select STM32_HAVE_DMA1
	select STM32_HAVE_DMA2
	select STM32_HAVE_ETHERNET
	select STM32_HAVE_ETH_RGMII
	select STM32_HAVE_IP_ETHMAC_V2
	select STM32_HAVE_I2C1
	select STM32_HAVE_I2C2
	select STM32_HAVE_I2C3
	select STM32_HAVE_I2C4
	select STM32_HAVE_LPTIM1
	select STM32_HAVE_LPTIM2
	select STM32_HAVE_LPTIM3
	select STM32_HAVE_LPTIM4
	select STM32_HAVE_LPTIM5
	select STM32_HAVE_LTDC
	select STM32_HAVE_MDF1
	select STM32_HAVE_MDF_AUDIO
	select STM32_HAVE_OTGHS
	select STM32_HAVE_RNG
	select STM32_HAVE_RTC
	select STM32_HAVE_RTC_MAGIC
	select STM32_HAVE_RTC_SUBSECONDS
	select STM32_HAVE_SAI1
	select STM32_HAVE_SDMMC1
	select STM32_HAVE_SDMMC2
	select STM32_HAVE_SPI1
	select STM32_HAVE_SPI2
	select STM32_HAVE_SPI3
	select STM32_HAVE_SPI4
	select STM32_HAVE_SPI5
	select STM32_HAVE_SPI6
	select STM32_HAVE_TIM1
	select STM32_HAVE_TIM2
	select STM32_HAVE_TIM3
	select STM32_HAVE_TIM4
	select STM32_HAVE_TIM5
	select STM32_HAVE_TIM6
	select STM32_HAVE_TIM7
	select STM32_HAVE_TIM8
	select STM32_HAVE_TIM9
	select STM32_HAVE_TIM10
	select STM32_HAVE_TIM11
	select STM32_HAVE_TIM12
	select STM32_HAVE_TIM13
	select STM32_HAVE_TIM14
	select STM32_HAVE_TIM15
	select STM32_HAVE_TIM16
	select STM32_HAVE_TIM17
	select STM32_HAVE_TIM2_32BITS
	select STM32_HAVE_TIM5_32BITS
	select STM32_HAVE_USART1
	select STM32_HAVE_USART2
	select STM32_HAVE_XSPI1
	select STM32_HAVE_XSPI2

config STM32_STM32N6XXXX
	bool
	default y

choice
	prompt "STM32 N6 Chip Selection"
	default ARCH_CHIP_STM32N657X0
	depends on ARCH_CHIP_STM32N6

config ARCH_CHIP_STM32N657X0
	bool "STM32N657X0"
	select ARMV8M_HAVE_ICACHE
	select ARMV8M_HAVE_DCACHE
	select STM32_STM32N6XXXX

endchoice

choice
	prompt "USB OTG HS instance"
	default STM32N6_OTGHS_USB1
	depends on STM32_OTGHS

config STM32N6_OTGHS_USB1
	bool "USB1"
	---help---
		Use USB1 OTG HS and its embedded high speed PHY.

config STM32N6_OTGHS_USB2
	bool "USB2"
	---help---
		Use USB2 OTG HS and its embedded high speed PHY.

endchoice

config STM32N6_DEBUG
	bool "Enable debugger access after boot"
	default n
	---help---
		Reopen secure and non-secure debugger access at the current hardware
		protection level early in startup.  The boot ROM can close this access
		when booting from external flash.  Enable this option for development
		to attach without switching to DEV boot mode.  This changes runtime
		BSEC registers only, not OTP fuses.

menu "DCMIPP Configuration"
	depends on STM32_DCMIPP

config STM32_DCMIPP_AE
	bool "Automatic exposure"
	default y
	select SCHED_LPWORK
	---help---
		Adjust the sensor exposure time, then the gain, from the pipe1
		statistics towards a target mean luminance.

config STM32_DCMIPP_AE_TARGET
	int "Target mean luminance"
	default 46
	range 16 224
	depends on STM32_DCMIPP_AE
	---help---
		Mean luminance (8-bit, linear, before gamma) of the frame.  46 is
		18 % of full scale, the reflectance of a middle grey.

config STM32_DCMIPP_AWB
	bool "Automatic white balance"
	default y
	select SCHED_LPWORK
	---help---
		Grey world white balance: adjust the red and blue gains of the
		pipe1 exposure block until the R, G and B means are equal.

config STM32_DCMIPP_ISP_INTERVAL
	int "Frames skipped after an update"
	default 4
	range 1 60
	depends on STM32_DCMIPP_AE || STM32_DCMIPP_AWB
	---help---
		Frames ignored after each exposure or white balance update; it
		must cover the sensor latency.

endmenu # DCMIPP Configuration

endif # ARCH_CHIP_STM32N6
