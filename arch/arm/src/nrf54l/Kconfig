#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

comment "nRF54L Configuration Options"

# nRF54L Families

choice
	prompt "nRF54L Chip Selection"
	default ARCH_CHIP_NRF54L15
	depends on ARCH_CHIP_NRF54L

config ARCH_CHIP_NRF54L15
	bool "nRF54L15"

config ARCH_CHIP_NRF54LM20A
	bool "nRF54LM20A"

config ARCH_CHIP_NRF54LM20B
	bool "nRF54LM20B"

endchoice # nRF54L Chip Selection

# Peripheral Selection

config NRF54L_UART
	bool
	default n

config NRF54L_TIMER
	bool
	default n

config NRF54L_PWM
	bool
	default n

menu "nRF54L Peripheral Selection"

config NRF54L_GPIOTE
	bool "GPIOTE (GPIO interrupts)"
	default n

config NRF54L_UART0
	bool "UART0"
	default n
	select UART0_SERIALDRIVER
	select NRF54L_UART
	---help---
		Enable UART0 (UARTE20). The board must provide
		BOARD_UART0_TX_PIN and BOARD_UART0_RX_PIN.

config NRF54L_UART1
	bool "UART1"
	default n
	select UART1_SERIALDRIVER
	select NRF54L_UART
	---help---
		Enable UART1 (UARTE21). The board must provide
		BOARD_UART1_TX_PIN and BOARD_UART1_RX_PIN.

config NRF54L_UART2
	bool "UART2"
	default n
	select UART2_SERIALDRIVER
	select NRF54L_UART
	---help---
		Enable UART2 (UARTE22). The board must provide
		BOARD_UART2_TX_PIN and BOARD_UART2_RX_PIN.

config NRF54L_UART3
	bool "UART3"
	default n
	select UART3_SERIALDRIVER
	select NRF54L_UART
	---help---
		Enable UART3 (UARTE30). The board must provide
		BOARD_UART3_TX_PIN and BOARD_UART3_RX_PIN.

config NRF54L_UART4
	bool "UART4"
	default n
	select UART4_SERIALDRIVER
	select NRF54L_UART
	---help---
		Enable UART4 (UARTE00). The board must provide
		BOARD_UART4_TX_PIN and BOARD_UART4_RX_PIN.

config NRF54L_UART5
	bool "UART5"
	default n
	depends on ARCH_CHIP_NRF54LM20A || ARCH_CHIP_NRF54LM20B
	select UART5_SERIALDRIVER
	select NRF54L_UART
	---help---
		Enable UART5 (UARTE23). The board must provide
		BOARD_UART5_TX_PIN and BOARD_UART5_RX_PIN.

config NRF54L_UART6
	bool "UART6"
	default n
	depends on ARCH_CHIP_NRF54LM20A || ARCH_CHIP_NRF54LM20B
	select UART6_SERIALDRIVER
	select NRF54L_UART
	---help---
		Enable UART6 (UARTE24). The board must provide
		BOARD_UART6_TX_PIN and BOARD_UART6_RX_PIN.

config NRF54L_TIMER0
	bool "TIMER0 (TIMER20)"
	select NRF54L_TIMER
	default n

config NRF54L_TIMER1
	bool "TIMER1 (TIMER21)"
	select NRF54L_TIMER
	default n

config NRF54L_TIMER2
	bool "TIMER2 (TIMER22)"
	select NRF54L_TIMER
	default n

config NRF54L_TIMER3
	bool "TIMER3 (TIMER23)"
	select NRF54L_TIMER
	default n

config NRF54L_TIMER4
	bool "TIMER4 (TIMER24)"
	select NRF54L_TIMER
	default n

config NRF54L_TIMER5
	bool "TIMER5 (TIMER00)"
	select NRF54L_TIMER
	default n

config NRF54L_TIMER6
	bool "TIMER6 (TIMER10)"
	select NRF54L_TIMER
	default n

config NRF54L_PWM0
	bool "PWM0 (PWM20)"
	select NRF54L_PWM
	depends on PWM
	default n

config NRF54L_PWM1
	bool "PWM1 (PWM21)"
	select NRF54L_PWM
	depends on PWM
	default n

config NRF54L_PWM2
	bool "PWM2 (PWM22)"
	select NRF54L_PWM
	depends on PWM
	default n

config NRF54L_GRTC
	bool "GRTC"
	default n

endmenu # nRF54L Peripheral Selection

menu "System Timer"

choice
	prompt "System Timer Source"
	default NRF54L_SYSTIMER_SYSTICK

config NRF54L_SYSTIMER_SYSTICK
	bool "SysTick"
	select TIMER
	select TIMER_ARCH
	select ARMV8M_SYSTICK

config NRF54L_SYSTIMER_GRTC
	bool "GRTC"
	select NRF54L_GRTC
	select ARCH_HAVE_TICKLESS
	select SCHED_TICKLESS
	select SCHED_TICKLESS_ALARM
	---help---
		Use the GRTC 1 MHz system counter and compare channel zero
		for tickless scheduling. The counter is kept active and uses
		the internal low-power RC oscillator as its LF clock source.

endchoice # System Timer Source

endmenu # System Timer

config NRF54L_DEBUG_ACCESS
	bool "Keep firmware-controlled debug access open"
	default y
	---help---
		Open unlocked TAMPC debug signals for SWD/RTT development.
		Signals locked by an earlier boot stage are left unchanged.

menu "GPIO Interrupt Configuration"

config NRF54L_PER_PIN_INTERRUPTS
	bool "Per-pin interrupt callbacks"
	default n
	depends on NRF54L_GPIOTE
	---help---
		Dispatch PORT events to separate callbacks for each pin.

endmenu # GPIO Interrupt Configuration

menu "PWM configuration"

if NRF54L_PWM

config NRF54L_PWM_MULTICHAN
	bool "PWM Multiple Output Channels"
	default n

if NRF54L_PWM_MULTICHAN

if NRF54L_PWM0

config NRF54L_PWM0_CH0
	bool "PWM0 Channel 0 Output"
	default n
	---help---
		Enables channel 0 output.

config NRF54L_PWM0_CH1
	bool "PWM0 Channel 1 Output"
	default n
	---help---
		Enables channel 1 output.

config NRF54L_PWM0_CH2
	bool "PWM0 Channel 2 Output"
	default n
	---help---
		Enables channel 2 output.

config NRF54L_PWM0_CH3
	bool "PWM0 Channel 3 Output"
	default n
	---help---
		Enables channel 3 output.

endif # NRF54L_PWM0

if NRF54L_PWM1

config NRF54L_PWM1_CH0
	bool "PWM1 Channel 0 Output"
	default n
	---help---
		Enables channel 0 output.

config NRF54L_PWM1_CH1
	bool "PWM1 Channel 1 Output"
	default n
	---help---
		Enables channel 1 output.

config NRF54L_PWM1_CH2
	bool "PWM1 Channel 2 Output"
	default n
	---help---
		Enables channel 2 output.

config NRF54L_PWM1_CH3
	bool "PWM1 Channel 3 Output"
	default n
	---help---
		Enables channel 3 output.

endif # NRF54L_PWM1

if NRF54L_PWM2

config NRF54L_PWM2_CH0
	bool "PWM2 Channel 0 Output"
	default n
	---help---
		Enables channel 0 output.

config NRF54L_PWM2_CH1
	bool "PWM2 Channel 1 Output"
	default n
	---help---
		Enables channel 1 output.

config NRF54L_PWM2_CH2
	bool "PWM2 Channel 2 Output"
	default n
	---help---
		Enables channel 2 output.

config NRF54L_PWM2_CH3
	bool "PWM2 Channel 3 Output"
	default n
	---help---
		Enables channel 3 output.

endif # NRF54L_PWM2

endif # NRF54L_PWM_MULTICHAN

if !NRF54L_PWM_MULTICHAN

config NRF54L_PWM0_CHANNEL
	int "PWM0 Output Channel"
	depends on NRF54L_PWM0
	default 0
	range 0 3

config NRF54L_PWM1_CHANNEL
	int "PWM1 Output Channel"
	depends on NRF54L_PWM1
	default 0
	range 0 3

config NRF54L_PWM2_CHANNEL
	int "PWM2 Output Channel"
	depends on NRF54L_PWM2
	default 0
	range 0 3

endif # !NRF54L_PWM_MULTICHAN

endif # NRF54L_PWM

endmenu # PWM configuration
